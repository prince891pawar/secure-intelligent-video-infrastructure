NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/secure-video
REDIS_URL=redis://127.0.0.1:6379
VITE_API_BASE_URL=http://localhost:4000
AUTH_SESSION_TTL_HOURS=24
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=5
STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=../../.local-media
MAX_UPLOAD_SIZE_BYTES=8589934592
UPLOAD_PART_SIZE_BYTES=16777216
UPLOAD_SESSION_TTL_HOURS=24
S3_BUCKET=replace-with-private-bucket-name
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
PROCESSING_CONCURRENCY=1
PROCESSING_MAX_DURATION_SECONDS=14400
PROCESSING_MAX_OUTPUT_BYTES=10737418240
PROCESSING_THREADS=2
PROCESSING_TIMEOUT_MS=1800000
PROCESSING_RECONCILE_INTERVAL_MS=10000
PROCESSING_STALE_AFTER_MS=28800000
PROCESSING_RESOLUTIONS=1080,720,480,360,240
PROCESSING_TEMP_ROOT=../../.processing-temp
PLAYBACK_SIGNING_SECRET=replace-with-at-least-32-random-bytes-for-playback-signing
